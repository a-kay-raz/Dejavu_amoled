<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Dejavu: what each version brought, and the tips about gestures, on top of every setting. -->
    <androidx.preference.PreferenceCategory
        android:key="@string/pref_key_dejavu_top_category"
        android:title="@string/dejavu_settings_title"
        android:layout="@layout/preference_category_no_icon_style">

        <androidx.preference.Preference
            android:icon="@drawable/mozac_ic_whats_new_24"
            android:key="@string/pref_key_dejavu_whats_new"
            android:summary="@string/dejavu_settings_whats_new_summary"
            android:title="@string/dejavu_settings_whats_new"
            app:widgetLayout="@layout/dejavu_preference_badge" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/mozac_ic_lightbulb_24"
            android:key="@string/pref_key_dejavu_tips"
            android:persistent="false"
            android:summary="@string/dejavu_settings_tips_summary"
            android:title="@string/dejavu_settings_tips" />

        <androidx.preference.Preference
            android:icon="@drawable/dejavu_ic_email_24"
            android:key="@string/pref_key_dejavu_email"
            android:summary="@string/dejavu_settings_email_summary"
            android:title="@string/dejavu_settings_email"
            app:widgetLayout="@layout/preference_widget_external_link" />
    </androidx.preference.PreferenceCategory>

    <!-- Dejavu: the account section is shown before signing in too, its sign in button telling what workspace sync
         does. -->
    <androidx.preference.PreferenceCategory
        android:key="@string/pref_key_account_category"
        android:title="@string/preferences_category_account"
        android:layout="@layout/preference_category_no_icon_style">

        <androidx.preference.Preference
            android:key="@string/pref_key_sign_in"
            android:layout="@layout/sign_in_preference"
            android:summary="@string/dejavu_sync_choose_about"
            android:title="@string/preferences_sign_in"
            app:allowDividerBelow="false" />

        <org.mozilla.fenix.settings.account.AccountPreference
            android:icon="@drawable/mozac_ic_avatar_circle_24"
            android:key="@string/pref_key_account"
            app:widgetLayout="@layout/dejavu_preference_badge" />

        <org.mozilla.fenix.settings.account.AccountAuthErrorPreference
            android:icon="@drawable/ic_account_warning"
            android:key="@string/pref_key_account_auth_error" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.Preference
        app:iconSpaceReserved="false"
        android:key="@string/pref_key_sync_debug"
        android:title="@string/preferences_sync_debug"
        app:isPreferenceVisible="false" />

    <!-- Dejavu: General opens screens that group its settings: tabs, workspaces and containers in one, Customize
         holds the theme, the tab actions, the menu and the bars, and passwords and language have one of their own. -->
    <androidx.preference.PreferenceCategory
        android:title="@string/preferences_category_general"
        android:layout="@layout/preference_category_no_icon_style">
        <androidx.preference.Preference
            app:iconSpaceReserved="false"
            android:key="@string/pref_key_search_settings"
            android:title="@string/preferences_search" />

        <androidx.preference.Preference
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/dejavu_preference_badge"
            android:key="@string/pref_key_dejavu_tabs_workspaces"
            android:title="@string/dejavu_settings_tabs_workspaces"
            android:summary="@string/dejavu_settings_tabs_workspaces_summary" />

        <androidx.preference.Preference
            app:widgetLayout="@layout/dejavu_preference_badge"
            android:key="@string/pref_key_customize"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_customize"
            android:summary="@string/dejavu_settings_customize_summary" />

        <androidx.preference.Preference
            app:iconSpaceReserved="false"
            app:widgetLayout="@layout/dejavu_preference_badge"
            android:key="@string/pref_key_dejavu_passwords_language"
            android:title="@string/dejavu_settings_passwords_language"
            android:summary="@string/dejavu_settings_passwords_language_summary" />

        <androidx.preference.Preference
            android:key="@string/pref_key_import_bookmarks"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preferences_import_bookmarks" />

        <org.mozilla.fenix.settings.DefaultBrowserPreference
            android:key="@string/pref_key_make_default_browser"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_set_as_default_browser" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/preferences_category_privacy_security"
        android:key="@string/pref_key_privacy_security_category"
        android:layout="@layout/preference_category_no_icon_style">

        <!-- Dejavu: private tabs live in the private workspace, and links from other apps can open in private tabs. -->
        <androidx.preference.Preference
            android:key="@string/pref_key_private_browsing"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preferences_private_browsing_options" />

        <!-- Dejavu: every protection on one screen of Dejavu's own, in place of Firefox's tracking protection, HTTPS-Only
             and secure DNS screens and of Dejavu's switches that were here. Site settings open from it. -->
        <androidx.preference.Preference
            android:key="@string/pref_key_dejavu_tracking_protection"
            app:iconSpaceReserved="false"
            android:title="@string/dejavu_settings_tracking_protection"
            android:summary="@string/dejavu_settings_tracking_protection_summary" />

        <org.mozilla.fenix.settings.IPProtectionPreference
            android:key="@string/pref_key_ip_protection_settings"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            app:allowDividerAbove="false"/>

        <androidx.preference.Preference
            android:key="@string/pref_key_https_only_settings"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preferences_https_only_title" />

        <androidx.preference.Preference
            android:key="@string/pref_key_doh_settings"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preference_doh_title" />

        <androidx.preference.Preference
            android:key="@string/pref_key_tracking_protection_settings"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preference_enhanced_tracking_protection" />

        <androidx.preference.Preference
            android:key="@string/pref_key_site_permissions"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preferences_site_settings" />

        <androidx.preference.Preference
            android:key="@string/pref_key_delete_browsing_data"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_delete_browsing_data" />

        <androidx.preference.Preference
            android:key="@string/pref_key_delete_browsing_data_on_quit_preference"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_delete_browsing_data_on_quit" />

        <androidx.preference.Preference
            android:key="@string/pref_key_notifications"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_notifications" />

        <androidx.preference.Preference
            android:key="@string/pref_key_data_choices"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_data_collection" />

    </androidx.preference.PreferenceCategory>

    <PreferenceCategory
        android:title="@string/preferences_category_advanced"
        android:key="@string/pref_key_advanced"
        android:layout="@layout/preference_category_no_icon_style">
        <androidx.preference.Preference
            android:key="@string/pref_key_addons"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_extensions" />

        <androidx.preference.Preference
            android:key="@string/pref_key_install_local_addon"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            android:title="@string/preferences_install_local_extension" />

        <androidx.preference.Preference
            android:key="@string/pref_key_override_amo_collection"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_customize_extension_collection" />

        <androidx.preference.Preference
            android:key="@string/pref_key_link_sharing"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_link_sharing" />

        <androidx.preference.Preference
            android:key="@string/pref_key_downloads"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_downloads_2" />

        <androidx.preference.Preference
            android:key="@string/pref_key_firefox_labs"
            app:iconSpaceReserved="false"
            android:title="@string/firefox_labs_title" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="@string/pref_key_leakcanary"
            android:title="@string/preference_leakcanary"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="@bool/IS_DEBUG" />

        <androidx.preference.Preference
            android:key="@string/pref_key_remote_improvements"
            android:title="@string/preferences_remote_improvements"
            app:iconSpaceReserved="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="@string/pref_key_remote_debugging"
            android:title="@string/preferences_remote_debugging"
            android:summary="@string/dejavu_remote_debugging_summary"
            app:iconSpaceReserved="false"
            android:defaultValue="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/pref_key_enable_gecko_logs"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_enable_gecko_logs" />

        <androidx.preference.Preference
            android:key="@string/pref_key_local_network_access"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_local_network_access" />
    </PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/preferences_category_about"
        app:iconSpaceReserved="false"
        android:layout="@layout/preference_category_no_icon_style">
        <androidx.preference.Preference
            app:widgetLayout="@layout/dejavu_preference_badge"
            android:key="@string/pref_key_about"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_about" />

        <androidx.preference.Preference
            android:key="@string/pref_key_debug_settings"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_debug_settings"
            app:isPreferenceVisible="false" />

        <androidx.preference.Preference
            android:key="@string/pref_key_nimbus_experiments"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_nimbus_experiments"
            app:isPreferenceVisible="false" />
        <androidx.preference.Preference
            android:key="@string/pref_key_start_profiler"
            app:iconSpaceReserved="false"
            android:title="@string/preferences_start_profiler"
            app:isPreferenceVisible="false" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
