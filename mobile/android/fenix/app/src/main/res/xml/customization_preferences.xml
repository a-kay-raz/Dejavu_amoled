<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/pref_key_customization_preference_screen" >
    <androidx.preference.PreferenceCategory
        android:layout="@layout/preference_cat_style"
        android:title="@string/preferences_app_icon"
        android:key="@string/pref_key_customization_category_app_icon"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false">
        <org.mozilla.fenix.iconpicker.ui.AppIconPreference
            android:key="@string/pref_key_app_icon" />
    </androidx.preference.PreferenceCategory>

    <!-- Dejavu: the app's icon, see AppIconPreference. -->
    <androidx.preference.PreferenceCategory
        android:layout="@layout/preference_cat_style"
        android:title="@string/dejavu_settings_app_icon"
        app:iconSpaceReserved="false">
        <org.mozilla.fenix.dejavu.settings.AppIconPreference
            android:key="@string/pref_key_dejavu_app_icon"
            android:persistent="false" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:layout="@layout/preference_cat_style"
        android:title="@string/preferences_theme"
        app:iconSpaceReserved="false">
        <org.mozilla.fenix.settings.RadioButtonPreference
            android:defaultValue="@bool/underAPI28"
            android:key="@string/pref_key_light_theme"
            android:title="@string/preference_light_theme" />

        <org.mozilla.fenix.settings.RadioButtonPreference
            android:defaultValue="false"
            android:key="@string/pref_key_dark_theme"
            android:title="@string/preference_dark_theme" />

        <org.mozilla.fenix.settings.RadioButtonPreference
            android:defaultValue="false"
            android:key="@string/pref_key_oled_theme"
            android:title="@string/preference_oled_theme"
            android:visible="false" />

        <org.mozilla.fenix.settings.RadioButtonPreference
            android:defaultValue="false"
            android:key="@string/pref_key_auto_battery_theme"
            android:title="@string/preference_auto_battery_theme"
            app:isPreferenceVisible="@bool/underAPI28" />

        <org.mozilla.fenix.settings.RadioButtonPreference
            android:defaultValue="@bool/API28"
            android:key="@string/pref_key_follow_device_theme"
            android:title="@string/preference_follow_device_theme"
            app:isPreferenceVisible="@bool/API28" />

        <!-- Dejavu: the accent color, see AccentColor. -->
        <org.mozilla.fenix.dejavu.settings.AccentColorPreference
            android:key="@string/pref_key_dejavu_accent_color"
            android:persistent="false" />
    </androidx.preference.PreferenceCategory>

    <!-- Dejavu: the style of the icons, see IconStyle. -->
    <androidx.preference.PreferenceCategory
        android:layout="@layout/preference_cat_style"
        android:title="@string/dejavu_settings_icons"
        app:iconSpaceReserved="false">
        <org.mozilla.fenix.dejavu.settings.IconStylePreference
            android:key="@string/pref_key_dejavu_icon_style"
            android:persistent="false" />
    </androidx.preference.PreferenceCategory>

    <!-- Dejavu: how much Dejavu's screens move, see DejavuMotion. -->
    <androidx.preference.PreferenceCategory
        android:layout="@layout/preference_cat_style"
        android:title="@string/dejavu_settings_animations"
        app:iconSpaceReserved="false">
        <androidx.preference.SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="@string/pref_key_dejavu_animations"
            android:persistent="false"
            android:title="@string/dejavu_settings_all_animations"
            android:summary="@string/dejavu_settings_all_animations_summary" />
        <androidx.preference.SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="@string/pref_key_dejavu_genie_effect"
            android:persistent="false"
            android:title="@string/dejavu_settings_genie_effect"
            android:summary="@string/dejavu_settings_genie_effect_summary" />
    </androidx.preference.PreferenceCategory>

    <!-- Dejavu: the tab actions and the menu are set up here, and the bars, the tab bar and the gestures, and the
         passwords, the language and the like open on screens of their own. -->
    <Preference
        android:layout="@layout/preference_spacer"
        android:selectable="false" />

    <androidx.preference.Preference
        app:iconSpaceReserved="false"
        app:widgetLayout="@layout/dejavu_preference_badge"
        android:key="@string/pref_key_dejavu_tab_actions"
        android:title="@string/dejavu_settings_tab_actions"
        android:summary="@string/dejavu_settings_tab_actions_entry_summary" />

    <androidx.preference.Preference
        app:iconSpaceReserved="false"
        app:widgetLayout="@layout/dejavu_preference_badge"
        android:key="@string/pref_key_dejavu_more_menu"
        android:title="@string/dejavu_settings_more_menu"
        android:summary="@string/dejavu_settings_more_menu_summary_2" />

    <androidx.preference.SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        android:key="@string/pref_key_dejavu_more_menu_hide_edit"
        android:persistent="false"
        android:title="@string/dejavu_more_menu_hide_edit"
        android:summary="@string/dejavu_more_menu_hide_edit_summary" />

    <androidx.preference.Preference
        app:iconSpaceReserved="false"
        app:widgetLayout="@layout/dejavu_preference_badge"
        android:key="@string/pref_key_dejavu_bars"
        android:title="@string/dejavu_settings_bars_2"
        android:summary="@string/dejavu_settings_bars_summary" />
</androidx.preference.PreferenceScreen>
